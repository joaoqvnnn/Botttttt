# Token do BotFather
BOT_TOKEN=123456:ABC-DEF...

# Canal obrigatório (use o @username público ou -100...)
CHANNEL_ID=@seucanal
CHANNEL_LINK=https://t.me/seucanal

# Grupo obrigatório
GROUP_ID=-1001234567890
GROUP_LINK=https://t.me/seugrupo

# URL pública do Render (ex: https://bellamy-bot.onrender.com)
WEBHOOK_URL=https://bellamy-bot.onrender.com
USE_WEBHOOK=true

# Postgres — no Render isso é preenchido automaticamente pelo render.yaml
# Localmente use: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=postgresql://usuario:senha@localhost:5432/bellamy
